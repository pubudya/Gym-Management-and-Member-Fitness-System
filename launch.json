{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Volt Gym",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "C:\\wamp64\\bin\\php\\php8.2.29\\php.exe",
      "runtimeArgs": [
        "-dxdebug.mode=off",
        "-S",
        "localhost:8080",
        "-t",
        "${workspaceFolder}",
        "${workspaceFolder}/router.php"
      ],
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "noDebug": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
        "uriFormat": "http://localhost:%s/"
      }
    },
    {
      "name": "Debug Volt Gym (Xdebug)",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "C:\\wamp64\\bin\\php\\php8.2.29\\php.exe",
      "runtimeArgs": [
        "-dxdebug.mode=debug,develop",
        "-dxdebug.start_with_request=yes",
        "-dxdebug.client_port=9003",
        "-S",
        "localhost:8080",
        "-t",
        "${workspaceFolder}",
        "${workspaceFolder}/router.php"
      ],
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
        "uriFormat": "http://localhost:%s/"
      }
    }
  ]
}
